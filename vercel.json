{
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "node ./node_modules/vite/bin/vite.js build",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mc.darktides.online" }],
      "destination": "/mc.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/dashboard/",
      "destination": "/dashboard.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mc.darktides.online" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
