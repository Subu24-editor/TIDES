VITE_DISCORD_CLIENT_ID=your_discord_client_id_here
VITE_DISCORD_GUILD_ID=1498057802499883181
VITE_DISCORD_ALLOWED_ROLES=1498057802499883185
VITE_DISCORD_ROLE_NAME=Admin

# Server-side only. Set this in Vercel -> Settings -> Environment Variables.
# Never commit a real value.
DISCORD_BOT_TOKEN=

# Optional: permanent invite code (the part after discord.gg/) used as a fallback for the live member count.
DISCORD_INVITE_CODE=thedarktides

# Optional: mirror PUBLIC Discord channels onto the site. The bot needs View Channel +
# Read Message History there, and "Message Content Intent" enabled in the Developer Portal.
# Announcements section (defaults to The Dark Tides announcements channel 1498745528534565075):
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
# Updates timeline feed (defaults to 1547570522663948349):
DISCORD_UPDATES_CHANNEL_ID=
